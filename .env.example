# Copy this file to .env (gitignored) and fill it in. Never commit .env.

# Which backend to use:
#   anthropic -> official Anthropic SDK (reads ANTHROPIC_API_KEY)
#   openai    -> official OpenAI SDK against any OpenAI-compatible endpoint
#                (OpenAI, DeepSeek, Groq, Gemini...; reads OPENAI_API_KEY)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5

# Only for LLM_PROVIDER=openai, for example https://api.deepseek.com
LLM_BASE_URL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional fixed demo clock (local time, ISO 8601). The app's sidebar can change it.
HEADSUP_NOW=2026-10-21T19:00
